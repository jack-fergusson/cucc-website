<!DOCTYPE html>
<html lang="en">
<head><%- include('head', { title: 'Events & club stories', description: 'Explore Queen’s Chess Club tournaments, university championships, results, and club stories.' }) %></head>
<body class="site-page">
<%- include('header') %>
<main id="main-content">
  <section class="site-shell page-intro"><p class="eyebrow">Over the board. Around the club.</p><h1>Every game has a story.</h1><p>Tournaments, team trips, and a few unforgettable moves.<br>Explore what we’ve been playing.</p></section>
  <section class="site-shell events-meeting"><div><span class="eyebrow">Always a good place to start</span><h2>Weekly club night</h2><p><%= club.meeting.day %> · <%= club.meeting.time %> · <%= club.meeting.location %></p></div><a class="button button-primary" href="/#visit">Come play <span aria-hidden="true">↗</span></a></section>
  <section class="site-shell archive-section" aria-labelledby="archive-title">
    <div class="section-heading"><div><p class="eyebrow">The archive</p><h2 id="archive-title">Past events & highlights</h2></div><div class="event-filters" aria-label="Filter events by year" hidden><% ['all', '2026', '2025', '2024'].forEach((year, index) => { %><button type="button" data-filter-year="<%= year %>" aria-pressed="<%= index === 0 %>"><%= year === 'all' ? 'All years' : year %></button><% }) %></div></div>
    <p class="archive-note">Looking for the next tournament? Watch <a href="<%= club.discord %>">Discord</a> and <a href="<%= club.instagram %>">Instagram</a> for new announcements.</p>
    <p class="sr-only" data-filter-status aria-live="polite" aria-atomic="true"></p>
    <div class="event-grid"><% events.forEach(event => { %><%- include('event-card', { event }) %><% }) %></div>
  </section>
  <%- include('join-banner') %>
</main>
<%- include('footer') %>
</body>
</html>
