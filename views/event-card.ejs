<article class="event-card" data-event-year="<%= event.year %>">
  <a href="<%= event.href %>" class="event-card__link">
    <div class="event-card__image"><img src="/images/<%= event.image %>" alt="" width="600" height="400" loading="lazy"><span class="event-tag"><%= event.type %></span></div>
    <div class="event-card__body"><p class="event-date"><%= event.date %> <span>· Past event</span></p><h3><%= event.title %></h3><p><%= event.description %></p><span class="card-link"><%= event.type === 'Team recap' ? 'Read the recap' : 'View event archive' %><span aria-hidden="true">↗</span></span></div>
  </a>
</article>
