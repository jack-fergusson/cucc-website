<footer class="site-footer">
  <div class="site-shell footer-grid">
    <div>
      <a class="site-brand" href="/"><img src="/images/logo.jpg" alt="" width="48" height="48"><span>Queen’s <strong>Chess Club</strong></span></a>
      <p>A place for every player.<br>Queen’s University · Kingston, Ontario</p>
    </div>
    <div>
      <h2>Over the board</h2>
      <p><%= club.meeting.day %> · <%= club.meeting.time %><br><%= club.meeting.location %></p>
      <a href="<%= club.meeting.maps %>" target="_blank" rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span></a>
    </div>
    <div>
      <h2>Keep in touch</h2>
      <div class="footer-socials"><a href="<%= club.discord %>">Discord ↗</a><a href="<%= club.instagram %>">Instagram ↗</a><a href="<%= club.facebook %>">Facebook ↗</a></div>
      <a class="footer-email" href="mailto:<%= club.email %>"><%= club.email %></a>
    </div>
  </div>
  <div class="site-shell footer-bottom"><span>© <%= new Date().getFullYear() %> Queen’s Chess Club</span><span>Good games. Better company.</span></div>
</footer>
<script src="/js/site.js" defer></script>
